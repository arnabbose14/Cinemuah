{
  "extends": null,
  "appId": "com.cinelocal.app",
  "productName": "Cinemuah",
  "directories": { "output": "release-mac" },
  "asarUnpack": ["node_modules/ffmpeg-static/**"],
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**",
    "!node_modules/**/*.{md,markdown,map,ts.map}",
    "!node_modules/.cache/**"
  ],
  "mac": {
    "category": "public.app-category.entertainment",
    "icon": "public/icon.png",
    "identity": null,
    "target": [{ "target": "dmg" }]
  },
  "dmg": {
    "title": "Cinemuah ${version}",
    "artifactName": "Cinemuah-${version}-${arch}.dmg"
  }
}
