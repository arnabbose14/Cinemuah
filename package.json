{
  "name": "cinelocal",
  "version": "1.0.0",
  "description": "Cinemuah - movies and series from your own library and online",
  "main": "dist-electron/electron/main.js",
  "homepage": "./",
  "author": "Cinemuah",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "tsc -p tsconfig.electron.json && vite build -c vite.app.config.ts",
    "build:electron": "npm run installer",
    "start": "electron .",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "pack": "npm run build && electron-builder --win --dir",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-installer.ps1"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "chromecast-api": "^0.4.2",
    "cors": "^2.8.6",
    "express": "^4.18.3",
    "ffmpeg-static": "^5.3.0",
    "mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.12.0",
    "webtorrent": "2.5.19"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.9.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.cinelocal.app",
    "productName": "Cinemuah",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**",
      "!node_modules/**/*.{md,markdown,map,ts.map}",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/cinemuah.ico",
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist"
  },
  "overrides": {
    "uint8-util": "2.2.5"
  }
}
