{
  "name": "cinemuah-android",
  "version": "1.0.0",
  "private": true,
  "description": "Cinemuah for Android (Capacitor wrapper around the shared React UI)",
  "scripts": {
    "build:web": "vite build --config vite.config.android.ts",
